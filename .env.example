# Docker Compose reads .env in the repository root.
POSTGRES_DB=room_find
POSTGRES_USER=room_find
# Set a local development password before starting Compose.
POSTGRES_PASSWORD=
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# false for local HTTP only; true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
# The Flask development server runs without the debugger by default.
FLASK_DEBUG=0
