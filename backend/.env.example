# Reference only: export these values; Flask does not load this file automatically.
FLASK_APP=app:create_app
# URL-encode special characters in the database username/password.
DATABASE_URL=postgresql+psycopg://room_find:replace-me@127.0.0.1:5432/room_find
# Tests require this dedicated database AND role, never a development database.
TEST_DATABASE_URL=postgresql+psycopg://room_find_test:test-only-password@127.0.0.1:55439/room_find_test
# Generate a random secret; minimum 32 characters, consistent across workers.
SECRET_KEY=replace-with-a-random-secret-before-running
# Set true on HTTPS deployments; false only for local HTTP.
SESSION_COOKIE_SECURE=false
